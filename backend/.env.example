# AgriBioTech Backend Production Environment Variables
# In production on Vercel or Render, configure these under Settings -> Environment Variables

# MongoDB Atlas or hosted database connection string (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agribiotech?retryWrites=true&w=majority

# JWT signing secret for auth tokens (Required)
JWT_SECRET=your_super_secret_production_jwt_key_at_least_32_chars

# Port for local development / non-serverless container (Defaults to 5000)
PORT=5000

# Node environment
NODE_ENV=production

# Optional Gemini API key for automated biotech recommendations
GEMINI_API_KEY=

# Optional CORS origin (Defaults to true/reflecting all origins, or set your frontend domain e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=
